<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tifusi_bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/tifusi_power"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/tifusi_power"
        android:textColor="@android:color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:text="@string/tifusi_off" />

    <LinearLayout
        android:id="@+id/tifusi_setup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/tifusi_scan"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="@color/tifusi_on"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:text="@string/tifusi_scan" />

        <Button
            android:id="@+id/tifusi_paste"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tifusi_text_dim"
            android:text="@string/tifusi_paste" />
    </LinearLayout>

    <TextView
        android:id="@+id/tifusi_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:textColor="@color/tifusi_text"
        android:textSize="18sp" />
</LinearLayout>
